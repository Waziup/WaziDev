            <text x="116" y="365" fill="var(--ink-3)" font-size="9">boots OFF</text>

            <!-- ===== ground rail ===== -->
            <line x1="40" y1="500" x2="940" y2="500" stroke="var(--ink-3)" stroke-width="3"/>
