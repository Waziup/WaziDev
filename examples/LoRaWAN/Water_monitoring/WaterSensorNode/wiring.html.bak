            <polygon points="140,200 160,200 150,180" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <line x1="150" y1="200" x2="150" y2="500" stroke="var(--ink-3)" stroke-width="1.6"/>
            <text x="172" y="186" font-size="10">TVS</text>
            <text x="172" y="199" fill="var(--ink-3)" font-size="9">solar input</text>

            <!-- controller out -->
            <line x1="298" y1="86"  x2="360" y2="86"  stroke="var(--rail12)" stroke-width="2"/>
            <line x1="298" y1="112" x2="325" y2="112" stroke="var(--ink-3)" stroke-width="2"/>
            <line x1="325" y1="112" x2="325" y2="500" stroke="var(--ink-3)" stroke-width="1.6"/>
            <text x="308" y="80" fill="var(--rail12)" font-size="10">+</text>
            <text x="331" y="130" fill="var(--ink-3)" font-size="10">−</text>

            <!-- ===== battery ===== -->
            <circle cx="360" cy="86" r="3.5" fill="var(--rail12)"/>
            <line x1="360" y1="86" x2="360" y2="140" stroke="var(--rail12)" stroke-width="2"/>
            <g stroke="currentColor" stroke-width="2">
              <line x1="342" y1="140" x2="378" y2="140"/>
              <line x1="350" y1="150" x2="370" y2="150"/>
              <line x1="342" y1="160" x2="378" y2="160"/>
              <line x1="350" y1="170" x2="370" y2="170"/>
            </g>
            <line x1="360" y1="170" x2="360" y2="500" stroke="var(--ink-3)" stroke-width="1.6"/>
            <text x="384" y="138" fill="var(--rail12)" font-size="12">+</text>
            <text x="384" y="176" fill="var(--ink-3)" font-size="12">−</text>
