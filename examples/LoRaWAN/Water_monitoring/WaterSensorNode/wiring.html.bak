            <text x="178" y="384" text-anchor="middle" font-size="11">XL6009</text>
            <text x="178" y="399" text-anchor="middle" fill="var(--ink-3)" font-size="10">3.7 → 12 V</text>
            <line x1="178" y1="418" x2="178" y2="500" stroke="var(--ink-3)" stroke-width="1.6"/>
            <text x="184" y="440" fill="var(--ink-3)" font-size="10">−</text>

            <line x1="236" y1="380" x2="290" y2="380" stroke="var(--rail12)" stroke-width="2"/>
            <rect x="290" y="362" width="126" height="56" rx="2" fill="var(--surface-2)" stroke="currentColor" stroke-width="1.5"/>
            <text x="353" y="384" text-anchor="middle" font-size="11">High-side sw</text>
            <text x="353" y="399" text-anchor="middle" fill="var(--ink-3)" font-size="10">Pololu #2811</text>
